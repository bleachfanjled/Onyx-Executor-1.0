{
  "name": "Script",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "is_free": {
      "type": "boolean",
      "default": false
    },
    "is_key_system": {
      "type": "boolean",
      "default": false
    },
    "is_universal": {
      "type": "boolean",
      "default": false
    },
    "safety_status": {
      "type": "string",
      "enum": [
        "pending",
        "safe",
        "flagged",
        "dangerous"
      ],
      "default": "pending"
    },
    "safety_score": {
      "type": "number",
      "default": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "downloads": {
      "type": "number",
      "default": 0
    },
    "rating_sum": {
      "type": "number",
      "default": 0
    },
    "rating_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "code"
  ]
}